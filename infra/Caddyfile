# Serves the exported web app and passes the API's paths to the API (infra/Dockerfile.web).
{
	admin off
	auto_https off
	persist_config off
}

:{$PORT} {
	encode zstd gzip

	@api path /api/* /admin /admin/* /static/* /healthz /healthz/
	handle @api {
		reverse_proxy {$API_UPSTREAM} {
			# TLS ended before this container; the API redirects to https unless it is told so.
			header_up X-Forwarded-Proto {$PUBLIC_SCHEME}
		}
	}

	handle {
		root * /srv
		# Hashed bundle names: cached for a year. The page itself is never cached, so a new version is
		# picked up on the next visit instead of an old index.html asking for bundles that are gone.
		@immutable path /_expo/static/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		@page not path /_expo/static/*
		header @page Cache-Control "no-cache"
		header {
			X-Content-Type-Options nosniff
			Referrer-Policy strict-origin-when-cross-origin
			-Server
		}
		try_files {path} {path}.html {path}/index.html /index.html
		file_server
	}
}
