# The live API image: gunicorn, with the admin's static files collected into the image (WhiteNoise serves
# them). Migrations are not run here: the live environment runs `python manage.py migrate --noinput` before
# the new version takes traffic (Render's preDeployCommand, the `migrate` service in docker-compose.prod.yml).
#
# At start-up the app checks its live keys (deploy/required-env.json, copied in below) and refuses to start,
# naming what is missing, while one is not set (apps/api/config/live_env.py).
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    DJANGO_SETTINGS_MODULE=config.settings.production \
    PORT=8000
WORKDIR /app
RUN useradd --create-home --uid 10001 app
COPY apps/api/requirements /app/requirements
RUN pip install -r requirements/base.txt
COPY apps/api /app
COPY deploy/required-env.json /app/required-env.json
# deploy/rollback.json, when the platform writes one, turns this version into the database rollback's first step
# (apps/core/management/commands/live_rollback.py); ops/ holds the one-off scripts and their rollbacks.
COPY deploy /app/deploy
COPY ops /app/ops
# Building has no live keys, and needs none: the check is skipped for this one command only.
RUN VK_SKIP_LIVE_ENV_CHECK=1 python manage.py collectstatic --noinput
USER app
EXPOSE 8000
# --preload: the settings (and the live-key check) load once, before any worker, so a missing key stops the
# server with one clear message instead of a worker boot loop.
CMD ["sh", "-c", "exec gunicorn config.wsgi --bind 0.0.0.0:${PORT} --workers ${WEB_CONCURRENCY:-2} --threads 4 --timeout 30 --max-requests 2000 --max-requests-jitter 200 --preload --access-logfile -"]
